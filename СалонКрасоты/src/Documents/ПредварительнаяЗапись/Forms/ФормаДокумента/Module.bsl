
&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.Услуги.ТекущиеДанные;
	Если ЗначениеЗаполнено(СтрокаТЧ.Услуга) Тогда
		СтрокаТЧ.Цена = РаботаСЦенами.ПолучитьЦенуНоменклатуры(СтрокаТЧ.Услуга,,Объект.Дата);
	Иначе
		СтрокаТЧ.Цена = 0;
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.Услуги.ТекущиеДанные;
	РаботаСТабличнымиЧастямиКлиент.ПересчитатьСуммуВСтрокеТабличнойЧасти(СтрокаТЧ);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.Услуги.ТекущиеДанные;
	РаботаСТабличнымиЧастямиКлиент.ПересчитатьСуммуВСтрокеТабличнойЧасти(СтрокаТЧ);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПриИзменении(Элемент)
	
	РаботаСТабличнымиЧастямиКлиент.ЗаполнитьСуммуДокумента(Объект);
	РассчитатьДатуОкончанияЗаписи();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗаписиПриИзменении(Элемент)
	
	РассчитатьДатуОкончанияЗаписи();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДатуОкончанияЗаписи()
	
	Если Не ЗначениеЗаполнено(Объект.ДатаЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	МассивУслуг = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Услуга) И МассивУслуг.Найти(СтрокаТЧ.Услуга) = Неопределено Тогда
			МассивУслуг.Добавить(СтрокаТЧ.Услуга);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивУслуг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеДлительностей = РаботаСРеквизитамиВызовСервера.ПолучитьРеквизитОбъекта(МассивУслуг, "ДлительностьУслуги");
	
	ДлительностьМинут = 0;
	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Услуга) Тогда
			СтруктураРеквизитов = СоответствиеДлительностей.Получить(СтрокаТЧ.Услуга);
			Если СтруктураРеквизитов <> Неопределено И ЗначениеЗаполнено(СтруктураРеквизитов.ДлительностьУслуги) Тогда
				ДлительностьМинут = ДлительностьМинут + СтруктураРеквизитов.ДлительностьУслуги;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ДлительностьМинут > 0 Тогда
		Объект.ДатаОкончанияЗаписи = Объект.ДатаЗаписи + (ДлительностьМинут * 60);
	КонецЕсли;
	
КонецПроцедуры
